# These are placeholders. Django reads the process environment; it does not load this file.
# Do not put real credentials into a tracked file.
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1
# SECRET_KEY: set a fresh randomly generated value, privately.
# DATABASE_URL: omit for local SQLite; production requires a separate PostgreSQL database.
MEDIA_BACKEND=local
# Production: DEBUG=false; MEDIA_BACKEND=cloudinary
# CLOUDINARY_URL: configure privately using a dedicated Cloudinary environment.
# CSRF_TRUSTED_ORIGINS=https://EXACT-HEROKU-APP-HOST
# ALLOWED_HOSTS=EXACT-HEROKU-APP-HOST
# EMAIL_HOST=YOUR-SMTP-HOST
# EMAIL_PORT=587
# EMAIL_HOST_USER=YOUR-SMTP-USER
# EMAIL_HOST_PASSWORD=SET-PRIVATELY
# DEFAULT_FROM_EMAIL=YOUR-VERIFIED-SENDER
# EMAIL_USE_TLS=true
